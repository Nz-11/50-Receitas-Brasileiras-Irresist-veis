# Copie para .env.local e preencha. Reinicie o servidor (npm run dev) após alterar.
# Variáveis NEXT_PUBLIC_ são incorporadas no build: em produção, defina-as antes de `npm run build`.

# Endereço público do site (usado nas imagens de compartilhamento). Ex.: https://seudominio.com.br
NEXT_PUBLIC_SITE_URL=

# URL do checkout externo (Hotmart, Kiwify, Eduzz, Mercado Pago...). Sem ela, os botões
# de compra mostram o aviso "Checkout ainda não configurado".
NEXT_PUBLIC_CHECKOUT_URL=

# Preço em reais, apenas números (ex.: 29.90). Vazio mostra "Preço a definir".
NEXT_PUBLIC_PRICE_BRL=

# Preço "de" para exibir promoção (ex.: 97.90). Só aparece se for maior que o preço de venda.
# Use apenas um valor realmente praticado antes (exigência do Código de Defesa do Consumidor).
NEXT_PUBLIC_PRICE_ORIGINAL_BRL=

# Texto sobre a entrega, somente depois de confirmado na plataforma de pagamento.
# Ex.: Você recebe o link de download no e-mail informado na compra.
NEXT_PUBLIC_DELIVERY_INFO=

# Garantia, somente se houver política real. Vazio = a página não menciona garantia.
NEXT_PUBLIC_GUARANTEE_INFO=

# Contato e políticas exibidos no rodapé
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_PRIVACY_URL=
NEXT_PUBLIC_TERMS_URL=
NEXT_PUBLIC_COMPANY_INFO=
